{
  "manifest_version": 3,
  "name": "GoFun - Go & Find 命令面板",
  "version": "1.2.0",
  "description": "GoFun（谐音 Go & Find）—— 使用快捷键呼出命令面板：跨窗口搜索 Tab/历史/书签/最近关闭/下载，执行 50+ 命令，内置计算器、Emoji、待办、天气、RSS、日历、截图、取色器、像素尺子、AI 聊天等工具。",
  "permissions": [
    "tabs",
    "history",
    "bookmarks",
    "activeTab",
    "scripting",
    "storage",
    "sessions",
    "downloads",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "打开命令面板（官方保底快捷键，在所有页面都可用）"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["palette.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GoFun - 打开命令面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
